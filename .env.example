APP_PASSWORD=
MEDIA_TICKET_SECRET=
# Diretório gravável opcional para estado local; o padrão continua sendo ./data.
# APP_DATA_DIR=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Limite por arquivo no plano gratuito da Groq (25 MB); dev tier aceita até 100 MB.
GROQ_STT_MAX_FILE_BYTES=25000000
GROQ_TIMEOUT_MS=45000
GROQ_MAX_RETRIES=2
GROQ_TPM=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AULA_GEMINI_MODEL=gemini-2.5-flash
# Transcrição de reserva (quando a Groq falha ou não está configurada). Padrão: gemini-3.5-transcribe; 'off' usa só o generateContent.
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# GEMINI_STT_TIMESTAMPS=1   # marcas de tempo por palavra (karaokê); a Google avisa que podem reduzir a precisão
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MAX_PROMPT_CHARS=300000
# OpenRouter (opcional; último recurso no modo auto, ou único com AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Lista prioritária opcional; quando preenchida substitui OPENROUTER_MODEL.
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,minimax/minimax-m3.1-flash:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_PROMPT_CHARS=120000

# Roteamento por tarefa em AI_PROVIDER=auto; limites de texto por processo.
AI_MAX_PARALLEL=3
AI_QUEUE_WAIT_MS=15000
# Overrides por tarefa (opcionais; têm prioridade sobre AULA_GEMINI_MODEL).
# AI_MODEL_AULA_FLASHCARDS_GROQ=openai/gpt-oss-20b
# AI_MODEL_MENTOR_CHAT_GROQ=openai/gpt-oss-120b
# Ordem opcional de provedores por tarefa (usa apenas provedores com chave):
# AI_ORDER_MENTOR_CHAT=groq,gemini,openrouter
# AI_ORDER_DOCUMENTO=gemini,openrouter,groq

# Busca semântica do acervo (opcional). O índice é criado com `npm run index:acervo-semantico`.
# A conta HF precisa aceitar a licença Gemma e ter permissão Inference Providers.
HF_TOKEN=
# Opcional: refina a ordem dos resultados; sem Cohere, usa similaridade vetorial.
COHERE_API_KEY=
HF_EMBEDDING_MODEL=google/embeddinggemma-300m
COHERE_RERANK_MODEL=rerank-v5.0-fast
# Busca vetorial opcional das Smart Questions; desligada por padrão.
# Ative somente após indexar vetores no staging/ambiente desejado com `npm run index:questions -- --apply --embed --target-ref=qbfcfxfzvahiuqvbflzf`.
ISC_QUESTION_EMBEDDINGS_ENABLED=0
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FLASHCARDS_ROOTS=ID|CAMINHO_DA_PASTA;ID|OUTRO_CAMINHO
GOOGLE_DRIVE_FLASHCARDS_CATALOG_PATH=
GOOGLE_DRIVE_FLASHCARDS_SYNC=true
FLASHCARD_MAX_PACKAGE_BYTES=104857600
FLASHCARD_MAX_PDF_BYTES=18874368
FLASHCARD_MAX_UNPACKED_BYTES=536870912
FLASHCARD_MAX_ARCHIVE_ENTRIES=50000
FLASHCARD_MAX_MEDIA_FILE_BYTES=26214400
FLASHCARD_MAX_MEDIA_TOTAL_BYTES=262144000
DRIVE_PUSH_WEBHOOK_URL=https://seu-dominio.com/webhooks/google-drive
DRIVE_PUSH_WEBHOOK_TOKEN=gere-um-segredo-aleatorio-longo
CRON_SECRET=gere-outro-segredo-aleatorio-longo
HARDWORQ_API_BASE=
HARDWORQ_AUTO_SYNC=
HARDWORQ_EMAIL=
HARDWORQ_HWQ_BASE=
HARDWORQ_ID_TURMA=
HARDWORQ_MAX_BANK=
HARDWORQ_SENHA=
HARDWORQ_SYNC_INTERVAL_H=
OPENAI_API_KEY=
OPENAI_MODEL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
APP_URL=http://localhost:3000

# Mídia pesada fora da Vercel (opcional). Veja docs/RODAR-LOCAL.md
# No app da Vercel: endereço HTTPS público do seu PC (túnel) que roda `npm run local:midia`.
MEDIA_ORIGIN=
# Vídeo direto do Google ao navegador (não passa pela Vercel). Exige conta de serviço. 1 = ligado.
# Se o Google recusar, o player repete sozinho pelo proxy do app. Compromisso: o navegador vê um token
# de curta duração (~1 h, somente leitura, só dos arquivos compartilhados com a conta de serviço).
DRIVE_DIRECT=
# O PC precisa do MESMO APP_PASSWORD e das credenciais do Drive. (MEDIA_ONLY é ligado por `npm run local:midia`.)
